<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Night mode -->
    <style name="Base.Theme.VoxBridge" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/teal_light</item>
        <item name="colorOnPrimary">@color/primary_navy_dark</item>
        <item name="colorPrimaryContainer">@color/teal_dark</item>
        <item name="colorOnPrimaryContainer">@color/teal_container</item>

        <item name="colorSecondary">@color/teal_light</item>
        <item name="colorOnSecondary">@color/primary_navy_dark</item>

        <!-- Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@color/primary_navy_dark</item>
        <item name="android:navigationBarColor">@color/primary_navy_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>